# Environment variables example for the deltaDAO Marketplace (Ocean Enterprise based)

#OE NODES
#DEFAULT OE NODE USED BY THE MARKETPLACE
NEXT_PUBLIC_PROVIDER_URL=https://<your-default-oe-node-url>
#OE NODE WHOSE METADATA CACHE IS USED BY THE MARKETPLACE TO READ ASSETS 
NEXT_PUBLIC_METADATACACHE_URI=["https://<your-oe-node-url>/"]
#LIST OF OE NODES WHOSE ASSETS WILL BE LISTED IN THE CATALOGUE AND THAT CAN BE USED TO ENCRYPT NEW ASSET DESCRIPTIONS AT PUBLISHING TIME
#NEXT_PUBLIC_NODE_URI_INDEXED=["https://ocean-node-vm7.oceanenterprise.io/", "https://ocean-node-vm7.oceanenterprise.io/"]

#BLOCKCHAIN RPC - e.g., OP Sepolia blockchain
NEXT_PUBLIC_NODE_URI_MAP={"11155420":"https://<your-rpc-provider-url-and-key>"}

#IPFS
NEXT_PUBLIC_IPFS_GATEWAY=https://<your-ipfs-gateway>
NEXT_PUBLIC_IPFS_UPLOAD_URL=https://<your-ipfs-provider-upload-url>
NEXT_PUBLIC_IPFS_DELETE_URL=https://<your-ipfs-provider-upload-url>
IPFS_JWT=<your-ipfs-jwt>
NEXT_PUBLIC_IPFS_UNPIN_FILES=true

#CURRENCIES AND MARKET FEES
#TOKENS - e.g., devEURAU on OP Sepolia
NEXT_PUBLIC_ALLOWED_ERC20_ADDRESSES={"11155420":["0xd35141583f374d401fee1bfddc35910e1d33a588"]}
#FIXED FEE - e.g., 1 devEURAU fixed fee for OP Sepolia
#NEXT_PUBLIC_CONSUME_MARKET_ORDER_FEE_MAP={"11155420":[{"token": "0xd35141583f374d401fee1bfddc35910e1d33a588", "amount": "1000000"}]}
#PERCENTAGE FEE - e.g., 10% percentage fee
#NEXT_PUBLIC_CONSUME_MARKET_FEE=0.1
#WALLET WHERE FEE IS COLLECTED
#NEXT_PUBLIC_MARKET_FEE_ADDRESS=<your-marketplace-wallet-address>

#SSI - used only if SSI is enabled
#NEXT_PUBLIC_SSI_ENABLED=true
#DEFAULT SSI WALLET
#NEXT_PUBLIC_SSI_WALLET_API=https://<your-ssi-wallet-url>
#OPA SERVER
#NEXT_PUBLIC_OPA_SERVER_URL=http://<your-opa-server>
#DEFAULT STATIC POLICIES APPLIED TO ALL VERIFIABLE CREDENTIALS
NEXT_PUBLIC_SSI_DEFAULT_POLICIES_URL=https://raw.githubusercontent.com/OceanProtocolEnterprise/policy-server/refs/heads/main/default-verification-policies

#DATASPACE NAME USED TO FILTER ASSETS 
#NEXT_PUBLIC_DATASPACE=

#LICENCE FILE SIZE LIMIT IN KB (USED TO VALIDATE LICENSE FILES UPLOADED BY PUBLISHERS)
NEXT_PUBLIC_MAX_LICENSE_FILE_SIZE_KB=700

#MARKET-LEVEL AUTHENTICATION USING AUTHENTIK SERVER
# Currently unused, kept for future use. Before re-enabling, note that
# upstream v1.5.0 changed two things about this flow:
#   1. The requested scopes were renamed to the oe-* namespace:
#      oe-central-federated_identity oe-organizationId oe-walletId
#      oe-signerServer oe-wellKnownUrl
#      The Authentik client must grant these and emit the matching claims,
#      including the new wellKnownUrl claim, or login fails outright. Nothing
#      in the build or the test suite detects this.
#   2. NEXT_PUBLIC_FEDERATED_OIDC_ISSUERS and
#      NEXT_PUBLIC_FEDERATED_OIDC_END_SESSION_URL were removed. Federated
#      logout now discovers end_session_endpoint from the provider's
#      well-known document, and the central IdP is identified by name via
#      NEXT_PUBLIC_CENTRAL_IDP_NAME below.
# NEXT_PUBLIC_AUTH_ENABLED=true
# NEXT_PUBLIC_AUTH_PROVIDER=oidc
# NEXT_PUBLIC_OIDC_ISSUER=<your_oidc_issuer_url>
# NEXT_PUBLIC_OIDC_CLIENT_ID=<your_oidc_client_id>
# OIDC_CLIENT_SECRET=<your_oidc_client_secret>
# NEXT_PUBLIC_OIDC_REDIRECT_URI=<your_oidc_redirect_uri>
# NEXT_PUBLIC_OIDC_TOKEN_URL=<your_oidc_token_url>
# NEXT_PUBLIC_OIDC_SCOPE=<space_separated_scopes> # Optional: defaults to the Authentik oe-* scopes; e.g. "openid profile email offline_access" for Keycloak
# NEXT_PUBLIC_OIDC_SIGNUP_FLOW=<your_oidc_signup_flow> # Optional: only needed if your OIDC provider has a separate signup flow
# NEXT_PUBLIC_CENTRAL_IDP_NAME=<your_dataspace_authentik_name> # Name of the central dataspace Authentik. Any other login source is treated as a partner IdP and logs out via well-known discovery. Unset falls back to the literal "main-oidc-provider", so set it when auth is enabled or every provider counts as a partner.

#DFNS SSO WALLET LOGIN - optional alternative to MetaMask after OIDC
# Requires NEXT_PUBLIC_AUTH_ENABLED=true as well: the wallet choice is gated on
# both. Set to true to offer Smart Account login, and configure the DFNS values
# below alongside it — enabling this without them surfaces a login option that
# cannot complete.
#NEXT_PUBLIC_DFNS_ENABLED=false
#NEXT_PUBLIC_DFNS_API_URL=https://api.dfns.io
#NEXT_PUBLIC_DFNS_RP_ID=<your_relying_party_base_domain_name> # Optional: only needed if your flow is DFNS Wallet Connection, it is mentioned in the dfns relying party configuration and is used to validate the wallet response. Example: "my-marketplace.com"

#ENCRYPTED JSON WALLET FILE IMPORT
#Keep the decrypted key in the browser session so the user stays connected across page reloads.
#NEXT_PUBLIC_PERSIST_JSON_WALLET_SESSION=true

#ASSET DETAIL PAGE
#Expand the asset description by default instead of showing it collapsed.
#NEXT_PUBLIC_ASSET_DESCRIPTION_EXPANDED_BY_DEFAULT=true

#PONTUS-X REGISTRY
#Resolve wallet addresses to legal names. Unset means the registry is never queried.
#NEXT_PUBLIC_PONTUSX_REGISTRY_URL=https://cache.registry.pontus-x.eu

#OTHERS
#ENCRYPT ASSET DESCRIPTION AT PUBLISHING TIME
NEXT_PUBLIC_ENCRYPT_ASSET=true
#HIDE ONBOARDING AT INITIAL ACCESS TIME 
NEXT_PUBLIC_HIDE_ONBOARDING_MODULE_BY_DEFAULT=false
#SSI WALLET UI USED IN THE ONBOARDING MODULE
#NEXT_PUBLIC_SSI_UI_URL=https://<your-wallet-ui-url>

# T&C Documents URLs - Using raw GitHub content URLs
# NEXT_PUBLIC_IMPRINT_URL=<your-imprint-url>
# NEXT_PUBLIC_TC_URL=<your-terms-and-conditions-url>
# NEXT_PUBLIC_PP_URL=<your-privacy-policy-url>
# NEXT_PUBLIC_CP_URL=<your-cookie-policy-url>
# NEXT_PUBLIC_DPUA_URL=<your-data-portal-usage-agreement-url>

#SITE URL / SEO
#Public origin of this marketplace, without trailing slash. Used for canonical URLs,
#og:url and og:image, robots.txt and sitemap.xml, and to decide which host may be indexed.
#It must be set at BUILD time (e.g. the Vercel Production environment, or a Docker build arg):
#statically rendered pages and the noindex header rule are generated during the build, so
#setting it only when the container starts does not make those pages indexable. Without it,
#the browser uses window.location.origin and the server the request host, then siteUrl from
#content/site.json, and every page stays noindex.
#NEXT_PUBLIC_SITE_URL=https://<your-marketplace-host>
#Search engines may index the site only on the NEXT_PUBLIC_SITE_URL host; every other host
#(e.g. preview URLs) gets noindex,nofollow and an X-Robots-Tag header. Set "true" to allow
#indexing on any host.
#NEXT_PUBLIC_ALLOW_INDEXING=false

#ANALYTICS (PostHog) - leave empty to disable analytics (default for self-hosting)
#PostHog uses cookies and localStorage, so it only starts after the visitor consents. That
#needs NEXT_PUBLIC_PRIVACY_PREFERENCE_CENTER=true, an analytics entry in content/gdpr.json and
#an updated privacy/cookie policy; without them PostHog stays off.
#NEXT_PUBLIC_POSTHOG_KEY=<your-posthog-project-api-key>
#NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
#Alternative or additional provider. Set the domain registered in your Plausible instance.
#NEXT_PUBLIC_PLAUSIBLE_DOMAIN=<your-site-domain>

#PRIVACY PREFERENCE CENTER / GDPR COOKIE BANNER - "true" shows the banner; "false" (default) hides it.
#Plausible runs without consent while the banner is off; PostHog never does.
#NEXT_PUBLIC_PRIVACY_PREFERENCE_CENTER=false
